# Required: your Etsy app keystring and shared secret (https://www.etsy.com/developers/your-apps)
ETSY_API_KEY=
ETSY_SHARED_SECRET=
# Optional: seeds ~/.config/etsy-mcp/tokens.json for headless use (otherwise run `npx @artisanxl/etsy-mcp login`)
# ETSY_REFRESH_TOKEN=
# Optional: comma-separated Toolsets (listings,shop,shipping,orders,reviews,taxonomy,users,other); unset = all
# ETSY_TOOLSETS=listings,orders
# Optional: port for the `login` callback (redirect URI http://localhost:<port>/callback); default 3003
# ETSY_REDIRECT_PORT=3003
# Optional: set to true to offer Write Tools (create/update/delete); default is Read-only Mode
# ETSY_ALLOW_WRITES=false
# Removed in 0.2.0: ETSY_ACCESS_TOKEN is ignored (a warning is printed). Use `login` or ETSY_REFRESH_TOKEN.
